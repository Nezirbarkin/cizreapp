<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Cizreapp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>cizreapp</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	
	<!-- Permissions - Camera -->
	<key>NSCameraUsageDescription</key>
	<string>CizreApp, ürün fotoğrafı çekmek, profil fotoğrafı güncellemek ve gönderi paylaşmak için kamera erişimi kullanır. Örneğin: Satmak istediğiniz ürünün fotoğrafını çekebilirsiniz.</string>
	
	<!-- Permissions - Photo Library -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CizreApp, galerinizden ürün veya gönderi fotoğrafı seçmek için fotoğraf kitaplığına erişir. Örneğin: Galerinizden bir ürün fotoğrafı seçip mağazanıza yükleyebilirsiniz.</string>
	
	<!-- Permissions - Microphone -->
	<key>NSMicrophoneUsageDescription</key>
	<string>CizreApp, video gönderileri ve hikayeleri için mikrofon erişimi kullanır. Örneğin: Ürün tanıtım videosu çekebilirsiniz.</string>
	
	<!-- Permissions - Location -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CizreApp, yakınınızdaki mağazaları ve ürünleri göstermek için konum bilginizi kullanır. Örneğin: Cizre'deki satıcıları ve kampanyaları harita üzerinde görebilirsiniz.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>CizreApp, siparişlerinizi takip etmek ve yakınınızdaki kampanyalardan haberdar olmak için konum bilginizi kullanır. Örneğin: Size en yakın mağazalardaki indirimlerden haberdar olabilirsiniz.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>CizreApp, siparişlerinizi takip etmek ve yakınınızdaki kampanyalardan haberdar olmak için arka planda konum bilginizi kullanır.</string>
	
	<!-- Deep Link - Email Doğrulama ve Şifre Yenileme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.cizreapp.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cizreapp</string>
			</array>
		</dict>
	</array>
	
	<!-- Export Compliance - Required for App Store -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
